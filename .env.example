# Example environment file (no real secrets here)

# HTTP server port (host side). Container always listens on 8787 (not secret)
PORT=8787

# Max age of a studio's cached classes before re-fetching, in seconds (not secret)
REFRESH_INTERVAL_SECONDS=900

# Optional cookie for FitX (SECRET). Leave empty here.
# FITX_COOKIE=

# ntfy topic URL for alerts when a gym's refresh starts failing or recovers. Anyone who knows
# the topic can read it, so use a random name, e.g. https://ntfy.sh/$(openssl rand -hex 12)
# NTFY_URL=

# Timezone used inside the container (not secret)
TZ=Europe/Berlin

# Cloudflare Tunnel token when using Docker-based tunnel (SECRET). Leave empty here.
# TUNNEL_TOKEN=

# Cloudflare Tunnel token (from Cloudflare dashboard)
# Used by the cloudflared sidecar to expose the service publicly.
# Treat as secret; do not commit a real token.
# CLOUDFLARED_TOKEN=eyJ...
